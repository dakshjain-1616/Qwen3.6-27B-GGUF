# Qwen3.6-27B GGUF Quantization Pipeline — Environment Variables

# HuggingFace token (required for upload, also used by huggingface_hub for downloads).
# Generate at https://huggingface.co/settings/tokens — needs 'write' scope to push.
HF_TOKEN=your_hf_token_here

# Optional: pipeline overrides via QWEN36GGUF_ env prefix.
# QWEN36GGUF_MODEL_ID=Qwen/Qwen3.6-27B
# QWEN36GGUF_OUTPUT_DIR=/path/to/output
# QWEN36GGUF_LLAMA_CPP_DIR=/path/to/llama.cpp
# QWEN36GGUF_HF_REPO_ID=daksh-neo/Qwen3.6-27B-GGUF
# QWEN36GGUF_HF_PRIVATE=false
